%start Module
%title "Oberon-0 Grammar (LL-style)"
%block_comment "\(\*" "\*\)"

%%

/*   0 */ Module: 'MODULE' Ident ';' Declarations ModuleOpt /* Option */ 'END' Ident '.';
/*   1 */ ModuleOpt /* Option<T>::Some */: 'BEGIN' StatementSequence;
/*   2 */ ModuleOpt /* Option<T>::None */: ;
/*   3 */ Declarations: ConstPart TypePart VarPart ProcedurePart;
/*   4 */ ConstPart: ConstPartOpt /* Option */;
/*   5 */ ConstPartOpt /* Option<T>::Some */: 'CONST' ConstDecls;
/*   6 */ ConstPartOpt /* Option<T>::None */: ;
/*   7 */ TypePart: TypePartOpt /* Option */;
/*   8 */ TypePartOpt /* Option<T>::Some */: 'TYPE' TypeDecls;
/*   9 */ TypePartOpt /* Option<T>::None */: ;
/*  10 */ VarPart: VarPartOpt /* Option */;
/*  11 */ VarPartOpt /* Option<T>::Some */: 'VAR' VarDecls;
/*  12 */ VarPartOpt /* Option<T>::None */: ;
/*  13 */ ProcedurePart: ProcedurePartList /* Vec */;
/*  14 */ ProcedurePartList /* Vec<T>::Push */: ProcedureDeclaration ';' ProcedurePartList;
/*  15 */ ProcedurePartList /* Vec<T>::New */: ;
/*  16 */ ProcedureDeclaration: ProcedureHeading ';' ProcedureBody;
/*  17 */ ProcedureHeading: 'PROCEDURE' Ident ProcedureHeadingOpt /* Option */;
/*  18 */ ProcedureHeadingOpt /* Option<T>::Some */: FormalParameters;
/*  19 */ ProcedureHeadingOpt /* Option<T>::None */: ;
/*  20 */ FormalParameters: '(' FormalParametersSuffix;
/*  21 */ FormalParametersSuffix: ')';
/*  22 */ FormalParametersSuffix: FPSection FPSectionRest ')';
/*  23 */ FPSectionRest: FPSectionRestList /* Vec */;
/*  24 */ FPSectionRestList /* Vec<T>::Push */: ';' FPSection FPSectionRestList;
/*  25 */ FPSectionRestList /* Vec<T>::New */: ;
/*  26 */ FPSection: 'VAR' IdentList ':' Type;
/*  27 */ FPSection: IdentList ':' Type;
/*  28 */ ProcedureBody: Declarations ProcedureBodyOpt /* Option */ ProcedureBodyOpt0 /* Option */ 'END' Ident;
/*  29 */ ProcedureBodyOpt0 /* Option<T>::Some */: 'RETURN' Expression;
/*  30 */ ProcedureBodyOpt0 /* Option<T>::None */: ;
/*  31 */ ProcedureBodyOpt /* Option<T>::Some */: 'BEGIN' StatementSequence;
/*  32 */ ProcedureBodyOpt /* Option<T>::None */: ;
/*  33 */ ConstDecls: ConstDeclsList /* Vec */;
/*  34 */ ConstDeclsList /* Vec<T>::Push */: Ident '=' Expression ';' ConstDeclsList;
/*  35 */ ConstDeclsList /* Vec<T>::New */: ;
/*  36 */ TypeDecls: TypeDeclsList /* Vec */;
/*  37 */ TypeDeclsList /* Vec<T>::Push */: Ident '=' Type ';' TypeDeclsList;
/*  38 */ TypeDeclsList /* Vec<T>::New */: ;
/*  39 */ VarDecls: VarDeclsList /* Vec */;
/*  40 */ VarDeclsList /* Vec<T>::Push */: IdentList ':' Type ';' VarDeclsList;
/*  41 */ VarDeclsList /* Vec<T>::New */: ;
/*  42 */ StatementSequence: StatementSequenceOpt /* Option */ StatementSequenceList /* Vec */;
/*  43 */ StatementSequenceList /* Vec<T>::Push */: ';' Statement StatementSequenceList;
/*  44 */ StatementSequenceList /* Vec<T>::New */: ;
/*  45 */ StatementSequenceOpt /* Option<T>::Some */: Statement;
/*  46 */ StatementSequenceOpt /* Option<T>::None */: ;
/*  47 */ Statement: Assignment;
/*  48 */ Statement: ProcedureCall;
/*  49 */ Statement: IfStatement;
/*  50 */ Statement: WhileStatement;
/*  51 */ Statement: RepeatStatement;
/*  52 */ Assignment: Ident Selector AssignOp Expression;
/*  53 */ ProcedureCall: Ident ProcedureCallOpt /* Option */;
/*  54 */ ProcedureCallOpt /* Option<T>::Some */: ActualParameters;
/*  55 */ ProcedureCallOpt /* Option<T>::None */: ;
/*  56 */ ActualParameters: '(' ActualParametersSuffix;
/*  57 */ ActualParametersSuffix: ')';
/*  58 */ ActualParametersSuffix: Expression ExpressionListRest ')';
/*  59 */ ExpressionListRest: ExpressionListRestList /* Vec */;
/*  60 */ ExpressionListRestList /* Vec<T>::Push */: ',' Expression ExpressionListRestList;
/*  61 */ ExpressionListRestList /* Vec<T>::New */: ;
/*  62 */ IfStatement: 'IF' Expression 'THEN' StatementSequence ElseIfList IfStatementOpt /* Option */ 'END';
/*  63 */ IfStatementOpt /* Option<T>::Some */: 'ELSE' StatementSequence;
/*  64 */ IfStatementOpt /* Option<T>::None */: ;
/*  65 */ ElseIfList: ElseIfListList /* Vec */;
/*  66 */ ElseIfListList /* Vec<T>::Push */: 'ELSIF' Expression 'THEN' StatementSequence ElseIfListList;
/*  67 */ ElseIfListList /* Vec<T>::New */: ;
/*  68 */ WhileStatement: 'WHILE' Expression 'DO' StatementSequence 'END';
/*  69 */ RepeatStatement: 'REPEAT' StatementSequence 'UNTIL' Expression;
/*  70 */ Expression: SimpleExpression ExpressionOpt /* Option */;
/*  71 */ ExpressionOpt /* Option<T>::Some */: RelationOp SimpleExpression;
/*  72 */ ExpressionOpt /* Option<T>::None */: ;
/*  73 */ SimpleExpression: Term SimpleExpressionList /* Vec */;
/*  74 */ SimpleExpressionList /* Vec<T>::Push */: AddOperator Term SimpleExpressionList;
/*  75 */ SimpleExpressionList /* Vec<T>::New */: ;
/*  76 */ Term: Factor TermList /* Vec */;
/*  77 */ TermList /* Vec<T>::Push */: MulOperator Factor TermList;
/*  78 */ TermList /* Vec<T>::New */: ;
/*  79 */ Factor: Ident Selector;
/*  80 */ Factor: Integer;
/*  81 */ Factor: '(' Expression ')';
/*  82 */ Factor: '~' Factor;
/*  83 */ Factor: UnaryOp Factor;
/*  84 */ Selector: SelectorList /* Vec */;
/*  85 */ SelectorList /* Vec<T>::Push */: SelectorListGroup SelectorList;
/*  86 */ SelectorListGroup: '.' Ident;
/*  87 */ SelectorListGroup: '[' Expression ']';
/*  88 */ SelectorList /* Vec<T>::New */: ;
/*  89 */ AssignOp: ':=';
/*  90 */ RelationOp: '>=';
/*  91 */ RelationOp: '<=';
/*  92 */ RelationOp: '=';
/*  93 */ RelationOp: '#';
/*  94 */ RelationOp: '<';
/*  95 */ RelationOp: '>';
/*  96 */ AddOperator: /\+|-|OR/;
/*  97 */ MulOperator: "\*|/|DIV|MOD|&";
/*  98 */ UnaryOp: /\+|-/;
/*  99 */ Type: Ident;
/* 100 */ Type: ArrayType;
/* 101 */ Type: RecordType;
/* 102 */ ArrayType: 'ARRAY' Expression 'OF' Type;
/* 103 */ RecordType: 'RECORD' FieldList FieldListRest 'END';
/* 104 */ FieldList: FieldListList /* Vec */;
/* 105 */ FieldListList /* Vec<T>::Push */: IdentList ':' Type FieldListList;
/* 106 */ FieldListList /* Vec<T>::New */: ;
/* 107 */ FieldListRest: FieldListRestList /* Vec */;
/* 108 */ FieldListRestList /* Vec<T>::Push */: ';' FieldList FieldListRestList;
/* 109 */ FieldListRestList /* Vec<T>::New */: ;
/* 110 */ IdentList: Ident IdentListList /* Vec */;
/* 111 */ IdentListList /* Vec<T>::Push */: ',' Ident IdentListList;
/* 112 */ IdentListList /* Vec<T>::New */: ;
/* 113 */ Ident: /[a-zA-Z][a-zA-Z0-9]*/;
/* 114 */ Integer: /[0-9]+/;
